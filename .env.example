# Required Configuration
API_KEY=your-api-key-here
GITHUB_TOKEN=your-github-token-here

# Shared secret for authenticating WhatsApp webhook requests
# The WhatsApp bridge sends this in the X-Webhook-Secret header
WEBHOOK_SECRET=your-webhook-secret-here

# OpenCode Configuration
# See https://opencode.ai/docs/providers/ for supported providers
OPENCODE_URL=http://opencode:4096
OPENCODE_PROVIDER_ID=anthropic
OPENCODE_MODEL_ID=claude-sonnet-4-20250514
OPENCODE_TIMEOUT=1800
# Optional: protect OpenCode server with basic auth
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode

# Provider API key (depends on OPENCODE_PROVIDER_ID)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Server Configuration (optional)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_TTL=86400

# Job Configuration (optional)
JOB_MAX_TIMEOUT=1800
JOB_RETRY_COUNT=3
JOB_RETRY_DELAY=5

# WhatsApp callback URL - where to POST agent questions and job results
# Set this to the WhatsApp service's /incoming endpoint
# e.g. http://whatsapp-service:3000/incoming
WHATSAPP_CALLBACK_URL=

# Bot GitHub account — used for push + PR creation
# PRs will show as authored by this bot account
# Generate a fine-grained PAT on the bot account with:
#   Contents: Read & Write, Pull requests: Read & Write
# Add the bot as a collaborator on target repos
GITHUB_BOT_TOKEN=your_github_bot_token_here
GITHUB_BOT_USERNAME=your_github_bot_username_here

