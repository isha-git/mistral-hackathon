# Required Configuration
API_KEY=your_api_key_here
MISTRAL_VIBE_API_KEY=your_mistral_vibe_key_here

# Server Configuration (optional)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_TTL=86400

# Mistral Vibe CLI Configuration (optional)
MISTRAL_VIBE_BASE_URL=http://localhost:8080
MISTRAL_VIBE_TIMEOUT=1800

# Job Configuration (optional)
JOB_MAX_TIMEOUT=1800
JOB_RETRY_COUNT=3
JOB_RETRY_DELAY=5

# WhatsApp callback URL - where to POST agent questions and job results
# Set this to the WhatsApp service's /incoming endpoint
# e.g. http://whatsapp-service:3000/incoming
WHATSAPP_CALLBACK_URL=
